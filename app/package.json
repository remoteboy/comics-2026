{
  "name": "comics-collection",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --ignore-path ../.prettierignore --write ..",
    "format:check": "prettier --ignore-path ../.prettierignore --check ..",
    "smoke:data": "node scripts/smoke-data.mjs",
    "smoke:covers": "node --env-file=.env scripts/smoke-covers.mjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:fixture": "node scripts/create-test-db.mjs",
    "test:e2e": "yarn test:fixture && playwright test",
    "test:e2e:ui": "yarn test:fixture && playwright test --ui",
    "test:ci": "yarn format:check && yarn check && yarn test && yarn build && yarn test:e2e",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate-database.mjs"
  },
  "dependencies": {
    "@astrojs/node": "11.1.6",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.5",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "6.0.3",
    "vite": "8.0.13",
    "vitest": "5.0.3"
  }
}
