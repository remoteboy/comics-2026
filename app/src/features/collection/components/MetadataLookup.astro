---
import type { MetadataSource } from '../metadata-lookup';
interface Props {
  id: number;
  sources: { provider: MetadataSource }[];
}
const { id, sources } = Astro.props;
---

{sources.length > 0 && (
  <section
    data-metadata-lookup
    data-endpoint={`/api/comics/${id}/metadata`}
    class="rounded-xl border border-zinc-800 p-5"
  >
    <h2 class="font-semibold text-white">Fetch missing details</h2>
    <p class="mt-1 text-sm leading-6 text-zinc-400">
      Fill empty fields and add missing creator credits from the saved provider
      match. Review the suggestions, then save comic details to apply them.
    </p>
    <div class="mt-3 flex flex-wrap gap-2">
      {sources.map(({ provider }) => (
        <button
          type="button"
          data-metadata-source={provider}
          class="rounded-lg border border-zinc-700 px-3 py-2 text-sm text-zinc-200"
        >
          Fetch from {provider === 'zap' ? 'Zap' : 'Comic Vine'}
        </button>
      ))}
    </div>
    <p
      data-metadata-message
      aria-live="polite"
      class="mt-3 text-sm leading-6 text-zinc-400"
    ></p>
    <div data-provider-notes hidden class="mt-4">
      <label class="text-sm text-zinc-300">
        Provider notes to review
        <textarea
          data-provider-notes-text
          readonly
          rows="6"
          class="mt-1 w-full rounded-lg border border-zinc-700 bg-zinc-900 px-3 py-2 text-white"
        ></textarea>
      </label>
      <button
        type="button"
        data-use-provider-notes
        class="mt-2 rounded-lg border border-zinc-700 px-3 py-2 text-sm text-zinc-200"
      >
        Use these notes
      </button>
      <p class="mt-2 text-xs text-zinc-500">
        This replaces the Comic notes field. Nothing is saved until you choose
        Save comic details.
      </p>
    </div>
    <noscript>
      <p class="mt-3 text-sm text-zinc-400">
        Enable JavaScript to fetch provider suggestions, or enter the details
        below.
      </p>
    </noscript>
  </section>
)}
