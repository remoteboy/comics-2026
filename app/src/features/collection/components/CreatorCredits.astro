---
import type { VariantCredit } from '@/features/collection/types';
import { database } from '@/db';
import { groupBy } from '@/lib/collections';
import { nonEmptyString } from '@/providers/utils';

interface Props {
  credits: VariantCredit[];
}

const credits = Astro.props.credits.filter((credit) =>
  nonEmptyString(credit.name),
);
const names = [...new Set(credits.map((credit) => credit.name))];
const records = names.length
  ? await database().all<{ id: number; name: string }>(
      `SELECT id,name FROM creators WHERE name IN (${names.map(() => '?').join(',')})`,
      names,
    )
  : [];
const ids = new Map(records.map((record) => [record.name, record.id]));
const grouped = groupBy(credits, (credit) => credit.role ?? 'credit');
---

<div class="rounded-xl border border-zinc-800 p-5">
  <h2 class="font-semibold text-white">Creators</h2>
  <div class="mt-4 space-y-4">
    {credits.length ? (
      [...grouped.entries()].map(([role, items]) => (
        <div>
          <p class="text-xs font-semibold tracking-wide text-zinc-600 uppercase">
            {role.replaceAll('_', ' ')}
          </p>
          <p class="mt-1.5 text-sm leading-6 text-zinc-300">
            {items.map((item, index) => (
              <>
                {index > 0 && ' · '}
                {ids.has(item.name) ? (
                  <a class="underline" href={`/creators/${ids.get(item.name)}`}>
                    {item.name}
                  </a>
                ) : (
                  item.name
                )}
              </>
            ))}
          </p>
        </div>
      ))
    ) : (
      <p class="text-sm text-zinc-500">No creator credits stored.</p>
    )}
  </div>
</div>
