---
import type { VariantDetail } from '@/features/collection/types';
import { formatMoney } from '@/lib/format';

interface Props {
  variant: VariantDetail;
}

const { variant } = Astro.props;
const rows = [
  ['Publisher', variant.publisherName ?? '—'],
  ['Issue type', variant.issueType === 'annual' ? 'Annual' : 'Issue'],
  ['Cover', variant.variantName || 'Regular cover'],
  ['Cover price', formatMoney(variant.coverPriceCents)],
  ['Story title', variant.storyTitle ?? '—'],
  ['Significance', variant.firstAppearanceOf || '—'],
];
---

<div class="rounded-xl border border-zinc-800 p-5">
  <h2 class="font-semibold text-white">Details</h2>
  <dl class="mt-4 space-y-3 text-sm">
    {rows.map(([label, value]) => (
      <div class="grid gap-1 sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-4">
        <dt class="text-zinc-500">{label}</dt>
        <dd class:list={['break-words text-zinc-300', label === 'Significance' && value !== '—' && 'text-amber-200/85']}>{value}</dd>
      </div>
    ))}
  </dl>
</div>
