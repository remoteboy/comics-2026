---
import SectionHeader from '@/components/SectionHeader.astro';
import CopyGroupCard from './CopyGroupCard.astro';
import { copyLabels, groupCopies } from '@/features/collection/copy-groups';
import type { HoldingListItem } from '@/features/collection/types';
import type { CurrentValuation } from '@/features/valuation/types';

interface Props {
  boxes: import('@/features/boxes/repository').BoxOption[];
  holdings: HoldingListItem[];
  valuations?: CurrentValuation[];
}
const { boxes, holdings, valuations = [] } = Astro.props;
const groups = groupCopies(holdings);
const labels = copyLabels(holdings);
const valuationsByHolding = new Map(
  valuations.map((valuation) => [valuation.holdingId, valuation]),
);
---

<section>
  <SectionHeader
    title={
      holdings.reduce((total, copy) => total + copy.quantity, 0) === 1
        ? 'Owned copy'
        : 'Owned copies'
    }
    description="Copies with the same cover, grade and box are shown together."
  />
  <div class="space-y-3">
    {!holdings.length && (
      <p class="text-sm text-zinc-400">
        You currently own no copies of this cover.
      </p>
    )}
    {groups.map((group) => (
      <CopyGroupCard
        group={group}
        boxes={boxes}
        labels={labels}
        valuations={valuationsByHolding}
      />
    ))}
  </div>
</section>
