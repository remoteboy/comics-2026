---
import type { HoldingListItem } from '@/features/collection/types';
import { formatGrade, formatMoney } from '@/lib/format';

interface Props {
  holdings: HoldingListItem[];
}

const { holdings } = Astro.props;
---

<section class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
  {holdings.map((holding) => (
    <>
      <div class="rounded-xl border border-zinc-800 bg-zinc-900/50 p-4">
        <p class="text-xs text-zinc-500 uppercase">Current value</p>
        <p class="mt-1 text-xl font-bold text-white">{formatMoney(holding.valueCents)}</p>
      </div>
      <div class="rounded-xl border border-zinc-800 bg-zinc-900/50 p-4">
        <p class="text-xs text-zinc-500 uppercase">Grade</p>
        <p class="mt-1 text-xl font-bold text-white">{formatGrade(holding.gradeTenths)}</p>
      </div>
      <div class="rounded-xl border border-zinc-800 bg-zinc-900/50 p-4">
        <p class="text-xs text-zinc-500 uppercase">Box</p>
        <p class="mt-1 text-xl font-bold text-white">{holding.boxId ?? 'Unboxed'}</p>
      </div>
      <div class="rounded-xl border border-zinc-800 bg-zinc-900/50 p-4">
        <p class="text-xs text-zinc-500 uppercase">Quantity</p>
        <p class="mt-1 text-xl font-bold text-white">{holding.quantity}</p>
      </div>
    </>
  ))}
</section>
