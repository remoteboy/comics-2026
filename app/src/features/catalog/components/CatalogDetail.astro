---
import AppLayout from '@/components/AppLayout.astro';
import CatalogSeries from './CatalogSeries.astro';
import TitleAutocomplete from '@/components/TitleAutocomplete.astro';
import PageHeader from '@/components/PageHeader.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import {
  catalogConfig,
  catalogAliases,
  listCatalog,
  type CatalogKind,
  type CatalogRecord,
} from '../repository';
interface Props {
  kind: CatalogKind;
  record: CatalogRecord;
  error?: string;
  submitted?: FormData;
}
const { kind, record, error, submitted } = Astro.props;
const config = catalogConfig(kind);
const query = Astro.url.searchParams.get('mergeSearch') ?? record.name;
const [aliases, targets] = await Promise.all([
  catalogAliases(kind, record.id),
  query.trim().length >= 2
    ? listCatalog(kind, query)
    : Promise.resolve({ items: [], total: 0 }),
]);
const requestId = crypto.randomUUID();
const inputClass =
  'w-full rounded-lg border border-zinc-700 bg-zinc-900 px-3 py-2 text-white';
const base = `${config.path}/${record.id}`;
---

<AppLayout title={record.name}>
  <Breadcrumbs
    items={[
      { label: config.label + 's', href: config.path },
      { label: record.name },
    ]}
  />
  <PageHeader
    title={record.name}
    description={`${record.comicCount} covers · ${record.copyCount} owned copies`}
  />
  {Astro.url.searchParams.get('saved') === '1' && (
    <p
      role="status"
      class="mb-5 rounded-lg bg-emerald-950 p-3 text-emerald-200"
    >
      Catalogue updated.
    </p>
  )}
  {error && (
    <p role="alert" class="mb-5 rounded-lg bg-red-950 p-3 text-red-200">
      {error}{' '}
      <a href={base} class="underline">
        Reload details
      </a>
    </p>
  )}
  {aliases.length > 0 && (
    <p class="mb-5 text-sm text-zinc-400">
      Also known as: {aliases.map((alias) => alias.name).join(' · ')}
    </p>
  )}
  <details
    class="mb-5 rounded-xl border border-zinc-800 p-4"
    open={Boolean(error)}
  >
    <summary class="cursor-pointer font-semibold text-white">{`Edit ${kind} name`}</summary>
    <form
      method="post"
      action={base}
      class="mt-4 flex flex-wrap items-end gap-3"
    >
      <input type="hidden" name="requestId" value={requestId} />
      <input type="hidden" name="version" value={String(record.editVersion)} />
      <input type="hidden" name="action" value="rename" />
      <label class="min-w-0 flex-1 text-sm text-zinc-300">
        Name
        <input
          class={inputClass + ' mt-1'}
          name="name"
          required
          maxlength="500"
          value={
            typeof submitted?.get('name') === 'string'
              ? String(submitted.get('name'))
              : record.name
          }
        />
      </label>
      <button class="rounded-lg bg-white px-4 py-2 font-semibold text-zinc-950">
        Save name
      </button>
      <p class="w-full text-sm text-zinc-400">
        The previous name stays searchable and future imports reuse this record.
      </p>
    </form>
  </details>
  <details
    class="mb-6 rounded-xl border border-zinc-800 p-4"
    open={
      Astro.url.searchParams.has('mergeSearch') ||
      submitted?.get('action') === 'merge'
    }
  >
    <summary class="cursor-pointer font-semibold text-white">
      Merge duplicates
    </summary>
    <p class="mt-3 text-sm text-zinc-400">
      Find the record you want to keep. All cover links and roles will move to
      it; duplicate credits will be combined. Old names will remain searchable.
    </p>
    <form method="get" action={base} class="mt-3 flex gap-2">
      <div class="min-w-0 flex-1">
        <TitleAutocomplete
          id="merge-search"
          endpoint={`/api/search/catalog?kind=${kind}`}
          scope={kind}
          selection="submit"
        >
          <label class="sr-only" for="merge-search">
            Find the record to keep
          </label>
          <input
            id="merge-search"
            class={inputClass}
            name="mergeSearch"
            minlength="2"
            maxlength="200"
            required
            value={query}
            placeholder="Name of the record to keep"
          />
        </TitleAutocomplete>
      </div>
      <button class="rounded-lg border border-zinc-700 px-3 py-2 text-white">
        Find record
      </button>
    </form>
    {query && (
      <form method="post" action={base} class="mt-4 space-y-3">
        <input type="hidden" name="requestId" value={crypto.randomUUID()} />
        <input
          type="hidden"
          name="version"
          value={String(record.editVersion)}
        />
        <input type="hidden" name="action" value="merge" />
        <fieldset>
          <legend class="mb-2 text-sm text-zinc-300">Keep this record</legend>
          <div class="space-y-2">
            {targets.items
              .filter((target) => target.id !== record.id)
              .map((target) => (
                <label class="flex gap-3 rounded-lg border border-zinc-700 p-3 text-zinc-200">
                  <input
                    type="radio"
                    name="target"
                    required
                    value={`${target.id}:${target.editVersion}`}
                  />
                  <span>
                    {target.name}
                    <span class="block text-xs text-zinc-400">
                      {target.comicCount} covers · {target.copyCount} owned
                      copies
                    </span>
                  </span>
                </label>
              ))}
          </div>
        </fieldset>
        {!targets.items.some((target) => target.id !== record.id) ? (
          <p class="text-sm text-zinc-400">
            No other matching records. Try a different name.
          </p>
        ) : (
          <>
            <label class="flex gap-2 text-sm text-zinc-300">
              <input type="checkbox" name="confirmed" value="1" required />
              {`I have checked that both records describe the same ${kind}.`}
            </label>
            <button class="rounded-lg border border-amber-600 px-4 py-2 font-semibold text-amber-200">
              Merge into selected record
            </button>
          </>
        )}
      </form>
    )}
  </details>
  <CatalogSeries kind={kind} id={record.id} />
</AppLayout>
