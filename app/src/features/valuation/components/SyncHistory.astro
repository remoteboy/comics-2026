---
import type { ValuationSyncRun } from '@/features/valuation/types';
import { formatDateTime } from '@/lib/format';

interface Props {
  runs: ValuationSyncRun[];
}

const { runs } = Astro.props;
---

<div class="overflow-hidden rounded-xl border border-zinc-800 bg-zinc-950">
  {runs.length ? (
    runs.map((run) => (
      <div class="flex flex-col gap-1 border-b border-zinc-900 px-4 py-3 text-sm last:border-0 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="font-medium text-zinc-200">
            Zap sync #{run.id} · {run.status}
          </p>
          <p class="mt-0.5 text-xs text-zinc-600">
            Started {formatDateTime(run.startedAt)}
          </p>
        </div>
        {run.errorText ? (
          <p class="max-w-xl text-xs text-rose-400">{run.errorText}</p>
        ) : (
          <p class="text-xs text-zinc-600">
            {run.completedAt
              ? `Completed ${formatDateTime(run.completedAt)}`
              : 'Running'}
          </p>
        )}
      </div>
    ))
  ) : (
    <p class="px-4 py-5 text-sm text-zinc-500">
      No valuation syncs recorded yet.
    </p>
  )}
</div>
