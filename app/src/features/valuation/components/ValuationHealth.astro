---
import type { ValuationHealthSummary } from '@/features/valuation/types';
import { formatInteger } from '@/lib/format';

interface Props {
  summary: ValuationHealthSummary;
}

const { summary } = Astro.props;
const items = [
  {
    label: 'Live Zap',
    value: summary.liveHoldings,
    detail: 'holdings with live valuations',
  },
  {
    label: 'Fresh',
    value: summary.freshHoldings,
    detail: 'refreshed in the last 7 days',
  },
  {
    label: 'Legacy fallback',
    value: summary.legacyHoldings,
    detail: 'still using migrated baseline',
  },
  {
    label: 'Missing',
    value: summary.missingHoldings,
    detail: 'holdings without a price',
  },
];
---

<div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
  {items.map((item) => (
    <div class="rounded-xl border border-zinc-800 bg-zinc-900/40 p-4">
      <p class="text-xs font-semibold tracking-wide text-zinc-500 uppercase">
        {item.label}
      </p>
      <p class="mt-2 text-2xl font-bold text-white">
        {formatInteger(item.value)}
      </p>
      <p class="mt-1 text-xs text-zinc-600">{item.detail}</p>
    </div>
  ))}
</div>
