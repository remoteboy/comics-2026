---
interface Props {
  record?: {
    id: number;
    type: string;
    label: string | null;
    version: number;
    entries: number;
  };
  submitted?: FormData;
}
const { record, submitted } = Astro.props;
const value = (name: string, fallback: string) =>
  typeof submitted?.get(name) === 'string'
    ? String(submitted.get(name))
    : fallback;
const field =
  'mt-1 w-full rounded-lg border border-zinc-700 bg-zinc-900 px-3 py-2 text-white';
---

<form method="post" class="max-w-2xl space-y-4">
  <input
    type="hidden"
    name="requestId"
    value={value('requestId', crypto.randomUUID())}
  />
  <input
    type="hidden"
    name="version"
    value={value('version', String(record?.version ?? 0))}
  />
  <input type="hidden" name="action" value={record ? 'edit' : 'create'} />
  {!record && (
    <label class="block text-sm text-zinc-300">
      <span id="box-number-label">Box number</span>
      <input
        name="number"
        type="number"
        aria-labelledby="box-number-label"
        min="1"
        step="1"
        value={value('number', '')}
        class={field}
      />
      <span class="mt-1 block text-xs text-zinc-500">
        Leave blank for the next available number. Existing box numbers stay the
        same.
      </span>
    </label>
  )}
  <label class="block text-sm text-zinc-300">
    <span id="box-label-label">Label</span>
    <input
      name="label"
      aria-labelledby="box-label-label"
      maxlength="500"
      value={value('label', record?.label ?? '')}
      class={field}
    />
    <span class="mt-1 block text-xs text-zinc-500">
      Optional, for example Marvel A–F.
    </span>
  </label>
  <label class="block text-sm text-zinc-300">
    <span id="box-type-label">Box type</span>
    <select name="type" aria-labelledby="box-type-label" class={field}>
      {['short', 'long', 'magazine'].map((type) => (
        <option
          value={type}
          selected={value('type', record?.type ?? 'short') === type}
        >
          {type[0].toUpperCase() + type.slice(1)}
        </option>
      ))}
    </select>
  </label>
  <div class="flex gap-3">
    <button class="rounded-lg bg-white px-4 py-2 font-semibold text-zinc-950">
      {record ? 'Save box details' : 'Create box'}
    </button>
    <a
      class="rounded-lg border border-zinc-700 px-4 py-2 text-zinc-300"
      href={record ? `/boxes/${record.id}` : '/boxes'}
    >
      Cancel
    </a>
  </div>
</form>
{record && (
  <details class="mt-8 max-w-2xl rounded-xl border border-zinc-800 p-4">
    <summary class="cursor-pointer font-semibold text-white">
      Remove empty box
    </summary>
    {record.entries > 0 ? (
      <p class="mt-3 text-sm text-zinc-400">
        Move the remaining collection entries out of this box first.
      </p>
    ) : (
      <form method="post" class="mt-4 space-y-3">
        <input type="hidden" name="requestId" value={crypto.randomUUID()} />
        <input type="hidden" name="version" value={String(record.version)} />
        <input type="hidden" name="action" value="delete" />
        <input type="hidden" name="type" value={record.type} />
        <input type="hidden" name="label" value={record.label ?? ''} />
        <label class="flex gap-2 text-sm text-zinc-300">
          <input type="checkbox" name="confirmed" value="1" required />
          {`Remove empty box ${record.id}.`}
        </label>
        <button class="rounded-lg border border-amber-600 px-4 py-2 font-semibold text-amber-200">
          Remove box
        </button>
      </form>
    )}
  </details>
)}
