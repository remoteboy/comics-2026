---
import CoverImage from '@/components/CoverImage.astro';
import type { HoldingListItemWithSeries } from '@/features/boxes/types';
import { groupBy } from '@/lib/collections';
import { formatGrade } from '@/lib/format';
import { groupCopies, groupUnitValue } from '@/features/collection/copy-groups';

interface Props {
  holdings: HoldingListItemWithSeries[];
}

const { holdings } = Astro.props;
const groups = groupBy(holdings, (holding) => holding.seriesName);
---

<div class="space-y-9">
  {[...groups.entries()].map(([seriesName, items]) => (
    <section>
      <div class="mb-3 flex items-baseline justify-between gap-4 border-b border-zinc-800 pb-2">
        <h2 class="font-semibold text-zinc-200">{seriesName}</h2>
        <span class="text-xs text-zinc-600">
          {items.reduce((sum, item) => sum + item.quantity, 0)} copies
        </span>
      </div>
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-6">
        {groupCopies(items).map((group) => {
          const holding = group.item;
          return (
            <a
              href={`/comics/${holding.variantId}?copy=${holding.holdingId}`}
              class="group overflow-hidden rounded-xl border border-zinc-800 bg-zinc-900/50 hover:border-zinc-700"
            >
              <CoverImage
                imageKey={holding.imageKey}
                alt={`${holding.seriesName} #${holding.issueNumber}`}
                class="w-full"
              />
              <div class="p-3">
                <div class="flex items-start justify-between gap-2">
                  <p class="truncate text-sm font-semibold text-zinc-100">
                    #{holding.issueNumber}
                  </p>
                  <span class="shrink-0 text-xs font-medium text-zinc-300">
                    {groupUnitValue(group)}
                  </span>
                </div>
                {group.unknownQuantity > 0 && (
                  <p class="mt-1 text-xs text-amber-300">
                    {group.unknownQuantity} awaiting value
                  </p>
                )}
                <p class="mt-1 truncate text-xs text-zinc-500">
                  {holding.variantName || 'Regular cover'}
                </p>
                <p class="mt-2 text-xs text-zinc-600">
                  Grade {formatGrade(holding.gradeTenths)}
                  {group.quantity > 1 ? ` · ×${group.quantity}` : ''}
                </p>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  ))}
</div>
