---
import { formatInteger, formatMoney } from '@/lib/format';
import type { SaleSummary } from '../types';

interface Props {
  summary: SaleSummary;
}

const { summary } = Astro.props;
---

<div class="grid gap-3 sm:grid-cols-3">
  <div class="rounded-xl border border-zinc-800 bg-zinc-950 p-4">
    <p class="text-xs font-medium tracking-wide text-zinc-500 uppercase">
      Candidates
    </p>
    <p class="mt-2 text-2xl font-bold text-white">
      {formatInteger(summary.automaticCandidates)}
    </p>
    <p class="mt-1 text-xs text-zinc-600">
      meet the current movement thresholds
    </p>
  </div>
  <div class="rounded-xl border border-zinc-800 bg-zinc-950 p-4">
    <p class="text-xs font-medium tracking-wide text-zinc-500 uppercase">
      Watched
    </p>
    <p class="mt-2 text-2xl font-bold text-white">
      {formatInteger(summary.watchedHoldings)}
    </p>
    <p class="mt-1 text-xs text-zinc-600">manually retained for review</p>
  </div>
  <div class="rounded-xl border border-zinc-800 bg-zinc-950 p-4">
    <p class="text-xs font-medium tracking-wide text-zinc-500 uppercase">
      Candidate value
    </p>
    <p class="mt-2 text-2xl font-bold text-white">
      {formatMoney(summary.candidateValueCents)}
    </p>
    <p class="mt-1 text-xs text-zinc-600">
      current unit values × owned quantity
    </p>
  </div>
</div>
