---
import {
  formatGrade,
  formatMoney,
  formatMoneyDelta,
  formatPercent,
} from '@/lib/format';
import type { SaleCandidate } from '../types';

interface Props {
  items: SaleCandidate[];
}

const { items } = Astro.props;
---

{items.length === 0 ? (
  <div class="rounded-xl border border-dashed border-zinc-800 px-5 py-10 text-center text-sm text-zinc-500">
    No holdings currently meet the sale thresholds and nothing is manually
    watched.
  </div>
) : (
  <div class="overflow-hidden rounded-xl border border-zinc-800">
    <div class="divide-y divide-zinc-800">
      {items.map((item) => (
        <article class="grid gap-4 bg-zinc-950 px-4 py-4 lg:grid-cols-[minmax(0,1fr)_9rem_9rem_9rem_auto] lg:items-center">
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2">
              <a
                href={`/sales/${item.holdingId}`}
                class="font-medium text-zinc-100 hover:text-white hover:underline"
              >
                {item.seriesName} #{item.issueNumber}
              </a>
              {item.variantName && (
                <span class="text-xs text-zinc-500">{item.variantName}</span>
              )}
              {item.watched === 1 && (
                <span class="rounded-full border border-amber-800/70 bg-amber-950/30 px-2 py-0.5 text-[11px] font-medium text-amber-200">
                  Watched
                </span>
              )}
            </div>
            <p class="mt-1 text-xs text-zinc-600">
              Grade {formatGrade(item.gradeTenths)} · Qty {item.quantity} ·{' '}
              {item.valuationProvider === 'zap'
                ? 'Live Zap'
                : 'Legacy fallback'}
            </p>
            {item.reasons.length > 0 && (
              <p class="mt-2 text-xs text-emerald-300">
                {item.reasons.join(' · ')}
              </p>
            )}
          </div>
          <div>
            <p class="text-[11px] text-zinc-600 uppercase">Current</p>
            <p class="mt-1 font-medium text-white">
              {formatMoney(item.currentPriceCents)}
            </p>
          </div>
          <div>
            <p class="text-[11px] text-zinc-600 uppercase">Best increase</p>
            <p class="mt-1 font-medium text-white">
              {formatMoneyDelta(item.bestAbsoluteMovementCents)}
            </p>
          </div>
          <div>
            <p class="text-[11px] text-zinc-600 uppercase">Best %</p>
            <p class="mt-1 font-medium text-white">
              {formatPercent(item.bestPercentageMovement)}
            </p>
          </div>
          <a
            href={`/sales/${item.holdingId}`}
            class="rounded-lg border border-zinc-700 px-3 py-2 text-center text-sm font-semibold text-zinc-200 hover:border-zinc-500 hover:text-white"
          >
            Review
          </a>
        </article>
      ))}
    </div>
  </div>
)}
