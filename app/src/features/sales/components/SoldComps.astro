---
import { formatDateTime, formatGrade, formatMoney } from '@/lib/format';
import type { ZapEbaySoldLookupResponse } from '@/providers/zap/live';

interface Props {
  response: ZapEbaySoldLookupResponse | null;
  holdingGradeTenths: number | null;
}

const { response, holdingGradeTenths } = Astro.props;
const gradeKey =
  holdingGradeTenths === null ? null : formatGrade(holdingGradeTenths);
const graded = gradeKey ? response?.graded_prices?.[gradeKey] : undefined;
---

<section class="rounded-xl border border-zinc-800 bg-zinc-950 p-5">
  <h2 class="font-semibold text-white">Recent sold comps</h2>
  {!response ? (
    <p class="mt-3 text-sm leading-6 text-zinc-500">
      No cached sold-comps lookup yet. Run the Zap lookup when you want market
      evidence for this holding.
    </p>
  ) : (
    <div class="mt-4 space-y-5">
      <div class="grid gap-3 sm:grid-cols-4">
        <div>
          <p class="text-xs text-zinc-600">Raw sales</p>
          <p class="mt-1 font-medium text-white">{response.sale_count ?? 0}</p>
        </div>
        <div>
          <p class="text-xs text-zinc-600">Median</p>
          <p class="mt-1 font-medium text-white">
            {response.median_price == null
              ? '—'
              : formatMoney(Math.round(response.median_price * 100))}
          </p>
        </div>
        <div>
          <p class="text-xs text-zinc-600">Range</p>
          <p class="mt-1 font-medium text-white">
            {response.min_price == null || response.max_price == null
              ? '—'
              : `${formatMoney(Math.round(response.min_price * 100))}–${formatMoney(Math.round(response.max_price * 100))}`}
          </p>
        </div>
        <div>
          <p class="text-xs text-zinc-600">Fetched</p>
          <p class="mt-1 font-medium text-white">
            {formatDateTime(response.fetched_at)}
          </p>
        </div>
      </div>

      {graded && (
        <div class="rounded-lg border border-zinc-800 px-3 py-3 text-sm text-zinc-300">
          Grade {gradeKey} sold average:{' '}
          <strong class="text-white">
            {formatMoney(Math.round(graded.avg * 100))}
          </strong>{' '}
          from {graded.count} graded sale{graded.count === 1 ? '' : 's'}.
        </div>
      )}

      {(response.raw_sample?.length ?? 0) > 0 && (
        <div>
          <h3 class="text-sm font-semibold text-zinc-200">Raw examples</h3>
          <div class="mt-2 space-y-2">
            {response.raw_sample!.slice(0, 5).map((sale) => (
              <a
                href={sale.url}
                target="_blank"
                rel="noreferrer"
                class="block rounded-lg border border-zinc-800 px-3 py-3 hover:border-zinc-700"
              >
                <span class="block text-sm text-zinc-200">{sale.title}</span>
                <span class="mt-1 block text-xs text-zinc-500">
                  {formatMoney(Math.round(sale.sold_price * 100))} ·{' '}
                  {formatDateTime(sale.date_sold)}
                </span>
              </a>
            ))}
          </div>
        </div>
      )}

      {(response.graded_sample?.length ?? 0) > 0 && (
        <div>
          <h3 class="text-sm font-semibold text-zinc-200">Graded examples</h3>
          <div class="mt-2 space-y-2">
            {response.graded_sample!.slice(0, 5).map((sale) => (
              <a
                href={sale.url}
                target="_blank"
                rel="noreferrer"
                class="block rounded-lg border border-zinc-800 px-3 py-3 hover:border-zinc-700"
              >
                <span class="block text-sm text-zinc-200">{sale.title}</span>
                <span class="mt-1 block text-xs text-zinc-500">
                  {sale.grading_company ?? 'Graded'}{' '}
                  {sale.detected_grade ?? '—'} ·{' '}
                  {formatMoney(Math.round(sale.sold_price * 100))} ·{' '}
                  {formatDateTime(sale.date_sold)}
                </span>
              </a>
            ))}
          </div>
        </div>
      )}

      <p class="text-xs leading-5 text-zinc-600">
        Zap's observed lookup separates raw and graded samples and filters many
        lot/noise results. Signed copies are not explicitly classified by the
        captured response contract, so verify unusual comps manually before
        listing.
      </p>
    </div>
  )}
</section>
