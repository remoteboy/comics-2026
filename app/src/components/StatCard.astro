---
interface Props {
  label: string;
  value: string;
  detail?: string;
}

const { label, value, detail } = Astro.props;
---

<div class="rounded-xl border border-zinc-800 bg-zinc-900/60 p-5">
  <p class="text-xs font-semibold tracking-wide text-zinc-500 uppercase">
    {label}
  </p>
  <p class="mt-2 text-2xl font-bold tracking-tight text-white">{value}</p>
  {detail && <p class="mt-1 text-xs text-zinc-500">{detail}</p>}
</div>
