---
interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<div class="rounded-xl border border-dashed border-zinc-800 px-6 py-12 text-center">
  <p class="font-medium text-zinc-200">{title}</p>
  {description && <p class="mt-1 text-sm text-zinc-500">{description}</p>}
</div>
