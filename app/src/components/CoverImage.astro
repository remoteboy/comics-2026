---
interface Props {
  imageKey: string | null;
  fallbackSrc?: string;
  alt: string;
  class?: string;
}

const { imageKey, fallbackSrc, alt, class: className = '' } = Astro.props;
const src = imageKey
  ? `/covers/${encodeURIComponent(imageKey)}`
  : (fallbackSrc ?? '/covers/missing.jpg');
---

<img
  src={src}
  alt={alt}
  width="400"
  height="600"
  loading="lazy"
  decoding="async"
  class:list={['aspect-[2/3] bg-zinc-900 object-cover', className]}
/>
