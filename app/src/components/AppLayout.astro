---
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Personal comics collection' } = Astro.props;
const pathname = Astro.url.pathname;

const navigation = [
  { href: '/', label: 'Dashboard' },
  { href: '/collection', label: 'Collection' },
  { href: '/boxes', label: 'Boxes' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <title>{title} · Comics</title>
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only z-50 rounded-md bg-white px-3 py-2 text-sm font-semibold text-zinc-950 focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Skip to content
    </a>
    <div class="min-h-screen lg:grid lg:grid-cols-[15rem_minmax(0,1fr)]">
      <aside class="border-b border-zinc-800 bg-zinc-950 lg:min-h-screen lg:border-r lg:border-b-0">
        <div class="lg:sticky lg:top-0 lg:px-6 lg:py-7">
          <div class="flex items-center gap-5 overflow-x-auto px-4 py-3 lg:block lg:px-0 lg:py-0">
            <a
              href="/"
              class="shrink-0 text-xl font-black tracking-tight text-white"
            >
              Comics
            </a>
            <nav
              aria-label="Primary"
              class="flex shrink-0 gap-1 lg:mt-8 lg:block lg:space-y-1"
            >
              {navigation.map((item) => {
                const active =
                  item.href === '/'
                    ? pathname === '/'
                    : pathname.startsWith(item.href);

                return (
                  <a
                    href={item.href}
                    aria-current={active ? 'page' : undefined}
                    class:list={[
                      'block rounded-lg px-3 py-2 text-sm font-medium',
                      active
                        ? 'bg-zinc-800 text-white'
                        : 'text-zinc-400 hover:bg-zinc-900 hover:text-zinc-100',
                    ]}
                  >
                    {item.label}
                  </a>
                );
              })}
            </nav>
          </div>
        </div>
      </aside>

      <main id="main-content" class="min-w-0">
        <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8 lg:py-9">
          <slot />
        </div>
      </main>
    </div>
  </body>
</html>
