---
import MoveNotice from '@/features/collection/components/MoveNotice.astro';
import { readableNotes } from '@/features/collection/readable-notes';
import { copyArchive } from '@/features/collection/copy-archive';
import { nonEmptyString } from '@/providers/utils';
import { listBoxOptions } from '@/features/boxes/repository';
import { database } from '@/db';
import AppLayout from '@/components/AppLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CoverImage from '@/components/CoverImage.astro';
import PageHeader from '@/components/PageHeader.astro';
import CreatorCredits from '@/features/collection/components/CreatorCredits.astro';
import ExternalReferences from '@/features/collection/components/ExternalReferences.astro';
import { purchaseDetails } from '@/features/collection/purchase-details';
import { copyLabels } from '@/features/collection/copy-groups';
import HoldingStats from '@/features/collection/components/HoldingStats.astro';
import VariantDetails from '@/features/collection/components/VariantDetails.astro';
import {
  getVariant,
  listVariantCredits,
  listVariantExternalReferences,
  listVariantHoldings,
} from '@/features/collection/variant.repository';
import PriceHistory from '@/features/valuation/components/PriceHistory.astro';
import {
  getCurrentValuation,
  listPriceHistory,
} from '@/features/valuation/repository';

const boxes = await listBoxOptions();
const id = Number(Astro.params.id);
const variant = await getVariant(id);
if (!variant) return Astro.redirect('/collection');

const [holdings, credits, externalReferences] = await Promise.all([
  listVariantHoldings(id),
  listVariantCredits(id),
  listVariantExternalReferences(id),
]);
const labels = copyLabels(holdings);
const owned = holdings.filter((copy) => copy.quantity > 0);
const removedCopies = (
  await Promise.all(
    holdings
      .filter((copy) => copy.quantity === 0)
      .map(async (copy) => ({
        copy,
        archive: await copyArchive(copy.holdingId),
      })),
  )
).filter((row) => row.archive);
variant.storyTitle = nonEmptyString(variant.storyTitle);
variant.firstAppearanceOf = nonEmptyString(variant.firstAppearanceOf);
variant.details = readableNotes(variant.details);
const zapCover = externalReferences.find(
  (ref) => ref.provider === 'zap' && /^\d+$/.test(ref.externalId),
);
const selectedCopyId = Number(Astro.url.searchParams.get('copy'));
const selectedCopy =
  holdings.find((holding) => holding.holdingId === selectedCopyId) ??
  owned[0] ??
  holdings[0];
const [history, valuations] = await Promise.all([
  selectedCopy ? listPriceHistory(selectedCopy.holdingId) : Promise.resolve([]),
  Promise.all(
    holdings.map((holding) => getCurrentValuation(holding.holdingId)),
  ),
]);
const currentValuations = valuations.filter(
  (valuation) => valuation !== undefined,
);
const intakeId = Number(Astro.url.searchParams.get('intake'));
const intakeWarnings =
  Number.isSafeInteger(intakeId) &&
  holdings.some((copy) => copy.holdingId === intakeId)
    ? await database().get<{ warnings: string }>(
        'SELECT warnings_json AS warnings FROM intake_requests WHERE result_holding_id=?',
        [intakeId],
      )
    : undefined;
const issueLabel = `${variant.issueType === 'annual' ? 'Annual ' : '#'}${variant.issueNumber}`;
const title = `${variant.seriesName} ${issueLabel}`;
---

<AppLayout title={title}>
  <MoveNotice />
  <Breadcrumbs
    items={[
      { href: '/collection', label: 'Collection' },
      { href: `/collection/${variant.seriesId}`, label: variant.seriesName },
      { label: issueLabel },
    ]}
  />
  <PageHeader
    title={title}
    eyebrow={variant.variantName || 'Regular cover'}
    description={variant.firstAppearanceOf || variant.storyTitle || undefined}
  />

  {(Astro.url.searchParams.get('saved') === '1' ||
    Astro.url.searchParams.get('metadataSaved') === '1') && (
    <p
      role="status"
      class="mb-5 rounded-lg border border-emerald-900 bg-emerald-950/30 p-4 text-emerald-200"
    >
      Saved to your collection.
    </p>
  )}
  {['removed', 'restored'].some(
    (key) => Astro.url.searchParams.get(key) === '1',
  ) && (
    <p
      role="status"
      class="mb-5 rounded-lg bg-emerald-950 p-4 text-emerald-200"
    >
      {Astro.url.searchParams.get('removed') === '1'
        ? 'Copies removed. Purchase details and price history are retained below.'
        : 'Copies restored.'}
    </p>
  )}
  {(intakeWarnings
    ? (JSON.parse(intakeWarnings.warnings) as string[])
    : []
  ).map((warning) => (
    <p class="mb-4 rounded-lg border border-amber-900 bg-amber-950/30 p-3 text-amber-200">
      {warning}
    </p>
  ))}
  <div class="grid gap-8 lg:grid-cols-[18rem_minmax(0,1fr)] xl:grid-cols-[20rem_minmax(0,1fr)]">
    <div>
      <CoverImage
        imageKey={variant.imageKey}
        fallbackSrc={
          zapCover
            ? `https://zkc-club-covers.s3.us-east-1.amazonaws.com/${zapCover.externalId}.jpg`
            : undefined
        }
        alt={title}
        class="w-full rounded-xl border border-zinc-800"
      />
      <a
        href={`/comics/${id}/edit`}
        class="mt-3 block rounded-lg border border-zinc-700 px-3 py-2 text-center text-sm font-semibold text-zinc-200 hover:bg-zinc-900"
      >
        Edit comic details
      </a>
      <a
        href={`/intake?series=${variant.seriesId}`}
        class="mt-3 block rounded-lg border border-zinc-700 px-3 py-2 text-center text-sm font-semibold text-zinc-200"
      >
        Add another issue
      </a>
      <a
        href={`/collection/${variant.seriesId}`}
        class="mt-3 block rounded-lg border border-zinc-800 px-3 py-2 text-center text-sm text-zinc-400 hover:bg-zinc-900 hover:text-white"
      >
        Back to {variant.seriesName}
      </a>
    </div>

    <div class="min-w-0 space-y-8">
      <HoldingStats
        boxes={boxes}
        holdings={owned}
        valuations={currentValuations}
      />
      {removedCopies.length > 0 && (
        <details
          id="removed-copies"
          open={Astro.url.searchParams.get('removed') === '1'}
          class="rounded-xl border border-zinc-800 p-5"
        >
          <summary class="cursor-pointer font-semibold text-zinc-300">
            Removed copies
          </summary>
          <div class="mt-4 space-y-4">
            {removedCopies.map(({ copy, archive }) => (
              <div class="text-sm text-zinc-400">
                <p>
                  {archive!.quantity}{' '}
                  {archive!.quantity === 1 ? 'copy' : 'copies'} ·{' '}
                  {purchaseDetails(copy)}
                </p>
                <div class="mt-2 flex gap-4">
                  <a
                    href={`/copies/${copy.holdingId}/remove`}
                    class="underline"
                  >
                    Restore copies
                  </a>
                  <a
                    href={`/comics/${id}?copy=${copy.holdingId}#price-history`}
                    class="underline"
                  >
                    Price history
                  </a>
                </div>
              </div>
            ))}
          </div>
        </details>
      )}

      <section class="grid gap-6 xl:grid-cols-2">
        <VariantDetails variant={variant} />
        <CreatorCredits credits={credits} />
      </section>

      {variant.details && (
        <section class="rounded-xl border border-zinc-800 p-5">
          <h2 class="font-semibold text-white">Notes</h2>
          <p class="mt-3 whitespace-pre-line break-words text-sm leading-6 text-zinc-400">
            {variant.details}
          </p>
        </section>
      )}

      <section class="grid gap-6 xl:grid-cols-2">
        <div id="price-history">
          {holdings.length > 1 && (
            <form method="get" class="mb-3 flex items-end gap-2">
              <label class="flex-1 text-sm text-zinc-400">
                <span id="copy-history-label">Price history for</span>
                <select
                  name="copy"
                  aria-labelledby="copy-history-label"
                  class="mt-1 w-full rounded-lg border border-zinc-700 bg-zinc-900 px-3 py-2 text-white"
                >
                  {holdings.map((holding) => (
                    <option
                      value={String(holding.holdingId)}
                      selected={selectedCopy?.holdingId === holding.holdingId}
                    >
                      {labels.get(holding.holdingId)} · grade{' '}
                      {holding.gradeTenths == null
                        ? 'unknown'
                        : (holding.gradeTenths / 10).toFixed(1)}{' '}
                      · {holding.boxId ? `Box ${holding.boxId}` : 'Unboxed'} ·
                      quantity {holding.quantity} · {purchaseDetails(holding)}
                    </option>
                  ))}
                </select>
              </label>
              <button class="rounded-lg border border-zinc-700 px-3 py-2 text-sm text-white">
                Show
              </button>
            </form>
          )}
          <PriceHistory history={history} />
        </div>
        <ExternalReferences references={externalReferences} />
      </section>
    </div>
  </div>
</AppLayout>
