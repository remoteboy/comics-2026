---
import AppLayout from '@/components/AppLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CoverImage from '@/components/CoverImage.astro';
import PageHeader from '@/components/PageHeader.astro';
import CreatorCredits from '@/features/collection/components/CreatorCredits.astro';
import ExternalReferences from '@/features/collection/components/ExternalReferences.astro';
import HoldingStats from '@/features/collection/components/HoldingStats.astro';
import VariantDetails from '@/features/collection/components/VariantDetails.astro';
import {
  getVariant,
  listVariantCredits,
  listVariantExternalReferences,
  listVariantHoldings,
} from '@/features/collection/variant.repository';
import PriceHistory from '@/features/valuation/components/PriceHistory.astro';
import { listPriceHistory } from '@/features/valuation/repository';

const id = Number(Astro.params.id);
const variant = await getVariant(id);
if (!variant) return Astro.redirect('/collection');

const [holdings, credits, externalReferences] = await Promise.all([
  listVariantHoldings(id),
  listVariantCredits(id),
  listVariantExternalReferences(id),
]);
const history = holdings[0] ? await listPriceHistory(holdings[0].holdingId) : [];
const title = `${variant.seriesName} #${variant.issueNumber}`;
---

<AppLayout title={title}>
  <Breadcrumbs items={[{ href: '/collection', label: 'Collection' }, { href: `/collection/${variant.seriesId}`, label: variant.seriesName }, { label: `#${variant.issueNumber}` }]} />
  <PageHeader
    title={title}
    eyebrow={variant.variantName || 'Regular cover'}
    description={variant.firstAppearanceOf || variant.storyTitle || undefined}
  />

  <div class="grid gap-8 lg:grid-cols-[18rem_minmax(0,1fr)] xl:grid-cols-[20rem_minmax(0,1fr)]">
    <div>
      <CoverImage imageKey={variant.imageKey} alt={title} class="w-full rounded-xl border border-zinc-800" />
      <a href={`/collection/${variant.seriesId}`} class="mt-3 block rounded-lg border border-zinc-800 px-3 py-2 text-center text-sm text-zinc-400 hover:bg-zinc-900 hover:text-white">Back to {variant.seriesName}</a>
    </div>

    <div class="min-w-0 space-y-8">
      <HoldingStats holdings={holdings} />

      <section class="grid gap-6 xl:grid-cols-2">
        <VariantDetails variant={variant} />
        <CreatorCredits credits={credits} />
      </section>

      {variant.details && (
        <section class="rounded-xl border border-zinc-800 p-5">
          <h2 class="font-semibold text-white">Notes</h2>
          <p class="mt-3 whitespace-pre-line break-words text-sm leading-6 text-zinc-400">{variant.details}</p>
        </section>
      )}

      <section class="grid gap-6 xl:grid-cols-2">
        <PriceHistory history={history} />
        <ExternalReferences references={externalReferences} />
      </section>
    </div>
  </div>
</AppLayout>
