---
import AppLayout from '@/components/AppLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import {
  changeCopyArchive,
  copyArchive,
} from '@/features/collection/copy-archive';
import {
  CopyEditConflict,
  getEditableCopy,
} from '@/features/collection/copy-edit';
import {
  formInteger,
  formText,
  limitedForm,
  sameOriginWrite,
} from '@/features/collection/write-form';
import { formatGrade } from '@/lib/format';
import { purchaseDetails } from '@/features/collection/purchase-details';
const id = Number(Astro.params.id);
const copy =
  Number.isSafeInteger(id) && id > 0 ? await getEditableCopy(id) : undefined;
if (!copy) return Astro.redirect('/collection');
Astro.response.headers.set('Cache-Control', 'no-store');
let error: string | undefined;
let conflict = false;
let data: FormData | undefined;
if (Astro.request.method === 'POST') {
  if (!sameOriginWrite(Astro.request, Astro.url)) {
    Astro.response.status = 403;
    error = 'Reload this copy page before trying again.';
  } else
    try {
      data = await limitedForm(Astro.request, 2048);
      const action = formText(data, 'action');
      if (action !== 'archive' && action !== 'restore')
        throw new Error('Choose remove or restore.');
      await changeCopyArchive({
        requestId: formText(data, 'requestId'),
        holdingId: id,
        expectedVersion: formInteger(data, 'expectedVersion'),
        action,
        confirmed: data.get('confirmed') === 'yes',
      });
      const latest = await getEditableCopy(id);
      return Astro.redirect(
        `/comics/${copy.variantId}?${latest?.quantity === 0 ? 'removed' : 'restored'}=1`,
        303,
      );
    } catch (cause) {
      conflict = cause instanceof CopyEditConflict;
      Astro.response.status = conflict ? 409 : 400;
      error =
        cause instanceof Error
          ? cause.message
          : 'Unable to update these copies.';
    }
}
const removed = copy.quantity === 0;
const archive = removed ? await copyArchive(id) : undefined;
const quantity = removed ? (archive?.quantity ?? 0) : copy.quantity;
const action = removed ? 'restore' : 'archive';
const title = `${copy.seriesName} ${copy.issueType === 'annual' ? 'Annual ' : '#'}${copy.issueNumber}`;
const entered = (name: string, fallback: string) =>
  typeof data?.get(name) === 'string' ? String(data.get(name)) : fallback;
---

<AppLayout title={`${removed ? 'Restore copies' : 'Remove copies'} · ${title}`}>
  <PageHeader
    title={removed ? 'Restore copies' : 'Remove copies'}
    description={title}
  />
  {error && (
    <p role="alert" class="mb-4 rounded-lg bg-red-950 p-3 text-red-200">
      {error}{' '}
      <a href={Astro.url.pathname} class="underline">
        Reload details
      </a>
    </p>
  )}
  <section class="max-w-2xl rounded-xl border border-zinc-800 p-5">
    <p class="text-zinc-300">
      {quantity} {quantity === 1 ? 'copy' : 'copies'} · grade{' '}
      {formatGrade(copy.gradeTenths)} ·{' '}
      {copy.boxId ? `Box ${copy.boxId}` : 'Unboxed'}
    </p>
    <p class="mt-2 text-sm text-zinc-400">{purchaseDetails(copy)}</p>
    <p class="mt-4 text-sm leading-6 text-zinc-400">
      {removed
        ? 'Restore the removed quantity with its purchase details and price history.'
        : 'Remove this purchase group from owned totals and box contents. Its purchase details and price history are retained, and you can restore it from the comic page.'}
    </p>
    {!removed && quantity > 1 && (
      <p class="mt-3 text-sm text-zinc-400">
        To remove only some copies,{' '}
        <a href={`/copies/${id}/edit`} class="underline">
          edit the group quantity
        </a>{' '}
        instead.
      </p>
    )}
    {(!removed || archive) && (
      <form method="post" class="mt-5 space-y-4">
        <input
          type="hidden"
          name="requestId"
          value={entered('requestId', crypto.randomUUID())}
        />
        <input
          type="hidden"
          name="expectedVersion"
          value={entered('expectedVersion', String(copy.editVersion))}
        />
        <input type="hidden" name="action" value={entered('action', action)} />
        <label class="flex gap-2 text-sm text-zinc-300">
          <input type="checkbox" name="confirmed" value="yes" required />{' '}
          {removed ? 'Restore' : 'Remove'} all {quantity}{' '}
          {quantity === 1 ? 'copy' : 'copies'} in this purchase group
        </label>
        <button
          disabled={conflict}
          class="rounded-lg bg-white px-4 py-2 font-semibold text-zinc-950"
        >
          {removed ? 'Restore copies' : 'Remove copies'}
        </button>
      </form>
    )}
    <a
      href={`/comics/${copy.variantId}`}
      class="mt-4 inline-block text-sm text-zinc-400 underline"
    >
      Back to comic
    </a>
  </section>
</AppLayout>
