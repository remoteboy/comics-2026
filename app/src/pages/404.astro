---
import AppLayout from '@/components/AppLayout.astro';
import EmptyState from '@/components/EmptyState.astro';
---

<AppLayout title="Not found">
  <div class="mx-auto max-w-xl py-16">
    <EmptyState title="That page does not exist" description="The collection data may have moved, or the requested record is not present in the migrated catalogue." />
    <div class="mt-4 text-center">
      <a href="/collection" class="inline-flex rounded-lg border border-zinc-800 px-4 py-2 text-sm text-zinc-300 hover:bg-zinc-900">Browse collection</a>
    </div>
  </div>
</AppLayout>
