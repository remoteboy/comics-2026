---
import AppLayout from '@/components/AppLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import EmptyState from '@/components/EmptyState.astro';
import PageHeader from '@/components/PageHeader.astro';
import StatCard from '@/components/StatCard.astro';
import HoldingCoverGrid from '@/features/collection/components/HoldingCoverGrid.astro';
import HoldingList from '@/features/collection/components/HoldingList.astro';
import { getSeries, listSeriesHoldings } from '@/features/collection/series.repository';
import { formatMoney } from '@/lib/format';

const id = Number(Astro.params.id);
const query = Astro.url.searchParams.get('q')?.trim() ?? '';
const view = Astro.url.searchParams.get('view') === 'list' ? 'list' : 'covers';
const [series, holdings] = await Promise.all([getSeries(id), listSeriesHoldings(id, query)]);

if (!series) return Astro.redirect('/collection');

const title = series.name;
const mostValuable = holdings.reduce<(typeof holdings)[number] | undefined>((best, holding) => {
  const value = (holding.valueCents ?? 0) * holding.quantity;
  const bestValue = best ? (best.valueCents ?? 0) * best.quantity : -1;
  return value > bestValue ? holding : best;
}, undefined);

function viewUrl(nextView: 'covers' | 'list'): string {
  const params = new URLSearchParams();
  if (nextView === 'list') params.set('view', 'list');
  if (query) params.set('q', query);
  const suffix = params.toString();
  return `/collection/${series.id}${suffix ? `?${suffix}` : ''}`;
}
---

<AppLayout title={title}>
  <Breadcrumbs items={[{ href: '/collection', label: 'Collection' }, { label: title }]} />
  <PageHeader
    title={title}
    eyebrow={series.publishers.join(' · ') || undefined}
    description={[series.startYear, series.status, `${series.issueCount} logical issues`].filter(Boolean).join(' · ')}
  >
    <div slot="actions" class="flex rounded-lg border border-zinc-800 bg-zinc-900 p-1 text-sm">
      <a href={viewUrl('covers')} aria-current={view === 'covers' ? 'page' : undefined} class:list={['rounded-md px-3 py-1.5', view === 'covers' ? 'bg-zinc-700 text-white' : 'text-zinc-400 hover:text-white']}>Covers</a>
      <a href={viewUrl('list')} aria-current={view === 'list' ? 'page' : undefined} class:list={['rounded-md px-3 py-1.5', view === 'list' ? 'bg-zinc-700 text-white' : 'text-zinc-400 hover:text-white']}>List</a>
    </div>
  </PageHeader>

  <section class="mb-7 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
    <StatCard label="Value" value={formatMoney(series.valueCents)} detail={mostValuable ? `Top: #${mostValuable.issueNumber} · ${formatMoney((mostValuable.valueCents ?? 0) * mostValuable.quantity)}` : undefined} />
    <StatCard label="Owned variants" value={String(series.ownedVariants)} detail={`${series.issueCount} logical issues`} />
    <StatCard label="Physical copies" value={String(series.physicalCopies)} detail={series.unboxedCopies ? `${series.unboxedCopies} unboxed` : 'All assigned to boxes'} />
    <StatCard label="Boxes" value={String(series.boxCount)} detail={series.unvaluedHoldings ? `${series.unvaluedHoldings} missing valuations` : 'No missing valuations'} />
  </section>

  <form method="get" class="mb-6 flex flex-col gap-2 sm:flex-row">
    {view === 'list' && <input type="hidden" name="view" value="list" />}
    <label class="min-w-0 flex-1">
      <span class="sr-only">Filter this series</span>
      <input type="search" name="q" value={query} placeholder="Find issue, variant, creator or significance…" class="w-full rounded-lg border border-zinc-700 bg-zinc-900 px-3.5 py-2.5 text-sm text-white outline-none placeholder:text-zinc-600 focus:border-zinc-500" />
    </label>
    <div class="flex gap-2">
      <button class="rounded-lg bg-zinc-100 px-4 py-2.5 text-sm font-semibold text-zinc-950 hover:bg-white">Filter</button>
      {query && <a href={viewUrl(view)} class="rounded-lg border border-zinc-800 px-3 py-2.5 text-sm text-zinc-400 hover:bg-zinc-900 hover:text-white">Clear</a>}
    </div>
  </form>

  {holdings.length ? (
    view === 'list' ? (
      <HoldingList holdings={holdings} seriesName={series.name} />
    ) : (
      <HoldingCoverGrid holdings={holdings} seriesName={series.name} />
    )
  ) : (
    <EmptyState title="No matching comics" description="Try a broader search within this series." />
  )}
</AppLayout>
