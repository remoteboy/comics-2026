---
import AppLayout from '@/components/AppLayout.astro';
import CoverImage from '@/components/CoverImage.astro';
import EmptyState from '@/components/EmptyState.astro';
import PageHeader from '@/components/PageHeader.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import StatCard from '@/components/StatCard.astro';
import {
  getDashboardSummary,
  getMostValuableHoldings,
  getRecentValuationChanges,
} from '@/features/dashboard/repository';
import { formatGrade, formatInteger, formatMoney, formatPercent } from '@/lib/format';

const [summary, valuable, changes] = await Promise.all([
  getDashboardSummary(),
  getMostValuableHoldings(),
  getRecentValuationChanges(),
]);
---

<AppLayout title="Dashboard">
  <PageHeader
    title="Collection overview"
    description="A read-only view of the migrated collection. Values are the last prices stored by the legacy application."
  />

  <section class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
    <StatCard label="Collection value" value={formatMoney(summary.collectionValueCents)} detail="Legacy valuation baseline" />
    <StatCard label="Physical copies" value={formatInteger(summary.physicalCopies)} detail={`${formatInteger(summary.seriesCount)} series`} />
    <StatCard label="Unboxed copies" value={formatInteger(summary.unboxedCopies)} detail={`${formatInteger(summary.boxedCopies)} boxed`} />
    <StatCard label="Missing valuations" value={formatInteger(summary.unvaluedHoldings)} detail="Holdings with no stored price" />
  </section>

  <div class="mt-10 grid gap-10 xl:grid-cols-[1.1fr_0.9fr]">
    <section>
      <SectionHeader title="Recent valuation history" description="Recovered Zap price snapshots from the legacy audit trail." />
      {
        changes.length ? (
          <div class="overflow-hidden rounded-xl border border-zinc-800">
            {changes.map((item) => (
              <a href={`/comics/${item.variantId}`} class="grid grid-cols-[3.25rem_1fr_auto] items-center gap-3 border-b border-zinc-800 bg-zinc-900/50 p-3 last:border-0 hover:bg-zinc-900">
                <CoverImage imageKey={item.imageKey} alt="" class="w-13 rounded-md" />
                <div class="min-w-0">
                  <p class="truncate text-sm font-medium text-zinc-100">{item.seriesName} #{item.issueNumber}</p>
                  <p class="mt-0.5 truncate text-xs text-zinc-500">
                    {[item.variantName, `Grade ${formatGrade(item.gradeTenths)}`, item.boxId ? `Box ${item.boxId}` : 'Unboxed'].filter(Boolean).join(' · ')}
                  </p>
                </div>
                <div class="text-right">
                  <p class="text-sm font-semibold text-white">{formatMoney(item.snapshotPriceCents)}</p>
                  <p class:list={['text-xs', item.changePercent != null && item.changePercent > 0 ? 'text-emerald-400' : 'text-zinc-500']}>
                    {item.previousPriceCents == null ? 'historical' : formatPercent(item.changePercent)}
                  </p>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <EmptyState title="No price history yet" />
        )
      }
    </section>

    <section>
      <SectionHeader title="Most valuable" description="Highest current stored values, including quantity." />
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 xl:grid-cols-2">
        {valuable.map((item) => (
          <a href={`/comics/${item.variantId}`} class="group overflow-hidden rounded-xl border border-zinc-800 bg-zinc-900/60">
            <CoverImage imageKey={item.imageKey} alt={`${item.seriesName} #${item.issueNumber}`} class="w-full" />
            <div class="p-3">
              <p class="truncate text-sm font-medium text-zinc-100 group-hover:text-white">{item.seriesName} #{item.issueNumber}</p>
              <div class="mt-1 flex items-center justify-between gap-2 text-xs">
                <span class="text-zinc-500">{formatGrade(item.gradeTenths)} · {item.boxId ? `Box ${item.boxId}` : 'Unboxed'}</span>
                <span class="font-semibold text-zinc-200">{formatMoney((item.valueCents ?? 0) * item.quantity)}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>
</AppLayout>
