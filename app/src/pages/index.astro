---
import AppLayout from '@/components/AppLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import StatCard from '@/components/StatCard.astro';
import CollectionHealth from '@/features/dashboard/components/CollectionHealth.astro';
import MoverList from '@/features/dashboard/components/MoverList.astro';
import ValuableGrid from '@/features/dashboard/components/ValuableGrid.astro';
import {
  getBiggestRecoveredMovers,
  getDashboardSummary,
  getMostValuableHoldings,
} from '@/features/dashboard/repository';
import { getValuationHealthSummary } from '@/features/valuation/repository';
import { formatInteger, formatMoney } from '@/lib/format';

const [summary, valuable, movers, valuationHealth] = await Promise.all([
  getDashboardSummary(),
  getMostValuableHoldings(8),
  getBiggestRecoveredMovers(10),
  getValuationHealthSummary(),
]);
---

<AppLayout title="Dashboard">
  <PageHeader
    title="Collection overview"
    description="Your collection, live Zap valuation coverage and recovered price history."
  />

  <div class="mb-7 rounded-xl border border-zinc-800 bg-zinc-950 px-4 py-3 text-sm text-zinc-400">
    <strong class="font-semibold text-zinc-200">Valuation coverage.</strong>{' '}
    {formatInteger(valuationHealth.liveHoldings)} holdings have live Zap
    valuations; {formatInteger(valuationHealth.legacyHoldings)} still use the
    migrated legacy fallback.{' '}
    <a
      href="/valuations"
      class="font-medium text-zinc-200 underline underline-offset-2 hover:text-white"
    >
      View freshness and sync history
    </a>
  </div>

  <section class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
    <StatCard
      label="Collection value"
      value={formatMoney(summary.collectionValueCents)}
      detail="Quantity-adjusted stored value"
    />
    <StatCard
      label="Physical copies"
      value={formatInteger(summary.physicalCopies)}
      detail={`${formatInteger(summary.seriesCount)} series`}
    />
    <StatCard
      label="Storage"
      value={`${formatInteger(summary.boxedCopies)} boxed`}
      detail={`${formatInteger(summary.unboxedCopies)} copies unboxed`}
    />
    <StatCard
      label="Price history"
      value={formatInteger(summary.priceSnapshotCount)}
      detail="Recovered + live change snapshots"
    />
  </section>

  <div class="mt-10 grid gap-10 xl:grid-cols-[1.12fr_0.88fr]">
    <section>
      <SectionHeader
        title="Biggest recorded moves"
        description="Largest stored price changes across recovered history and live Zap syncs."
      />
      <MoverList items={movers} />
    </section>

    <section>
      <SectionHeader
        title="Most valuable"
        description="Highest stored holding values, including quantity."
      />
      <ValuableGrid items={valuable} />
    </section>
  </div>

  <section class="mt-10">
    <SectionHeader
      title="Collection health"
      description="Storage and valuation coverage that still needs attention."
    />
    <CollectionHealth summary={summary} />
  </section>
</AppLayout>
