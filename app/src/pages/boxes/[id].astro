---
import AppLayout from '@/components/AppLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import PageHeader from '@/components/PageHeader.astro';
import StatCard from '@/components/StatCard.astro';
import BoxHoldings from '@/features/boxes/components/BoxHoldings.astro';
import { getBox, getBoxNavigation } from '@/features/boxes/repository';
import { formatMoney } from '@/lib/format';

const id = Number(Astro.params.id);
const [box, navigation] = await Promise.all([getBox(id), getBoxNavigation(id)]);
if (!box) return Astro.redirect('/boxes');
const title = box.label || `Box ${box.id}`;
---

<AppLayout title={title}>
  <Breadcrumbs items={[{ href: '/boxes', label: 'Boxes' }, { label: title }]} />
  <PageHeader title={title} eyebrow={`${box.type} box · #${box.id}`}>
    <div slot="actions" class="flex gap-2">
      {navigation.previousId && <a href={`/boxes/${navigation.previousId}`} aria-label={`Previous box, ${navigation.previousId}`} class="rounded-lg border border-zinc-800 px-3 py-2 text-sm text-zinc-300 hover:bg-zinc-900">← {navigation.previousId}</a>}
      {navigation.nextId && <a href={`/boxes/${navigation.nextId}`} aria-label={`Next box, ${navigation.nextId}`} class="rounded-lg border border-zinc-800 px-3 py-2 text-sm text-zinc-300 hover:bg-zinc-900">{navigation.nextId} →</a>}
    </div>
  </PageHeader>

  <section class="mb-8 grid gap-3 sm:grid-cols-3">
    <StatCard label="Value" value={formatMoney(box.valueCents)} />
    <StatCard label="Physical copies" value={String(box.copyCount)} />
    <StatCard label="Holdings" value={String(box.holdingCount)} />
  </section>

  <BoxHoldings holdings={box.holdings} />
</AppLayout>
