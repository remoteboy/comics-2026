---
import MoveNotice from '@/features/collection/components/MoveNotice.astro';
import { listBoxOptions } from '@/features/boxes/repository';
import AppLayout from '@/components/AppLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import PageHeader from '@/components/PageHeader.astro';
import StatCard from '@/components/StatCard.astro';
import EmptyState from '@/components/EmptyState.astro';
import { database } from '@/db';
import BoxHoldings from '@/features/boxes/components/BoxHoldings.astro';
import { getBox, getBoxNavigation } from '@/features/boxes/repository';
import { formatMoney } from '@/lib/format';

const boxes = await listBoxOptions();
const id = Number(Astro.params.id);
const [box, navigation] = await Promise.all([getBox(id), getBoxNavigation(id)]);
if (!box) return Astro.redirect('/boxes');
const title = box.label || `Box ${box.id}`;
const seriesId = Number(Astro.url.searchParams.get('series'));
const selectedSeries =
  Number.isSafeInteger(seriesId) && seriesId > 0
    ? await database().get<{ id: number; name: string }>(
        'SELECT id,name FROM series WHERE id=?',
        [seriesId],
      )
    : undefined;
const holdings = selectedSeries
  ? box.holdings.filter((copy) => copy.seriesId === seriesId)
  : box.holdings;
const boxUrl = (id: number) =>
  `/boxes/${id}${selectedSeries ? `?series=${selectedSeries.id}` : ''}`;
const value = holdings.reduce(
  (sum, copy) => sum + (copy.valueCents ?? 0) * copy.quantity,
  0,
);
const quantity = holdings.reduce((sum, copy) => sum + copy.quantity, 0);
---

<AppLayout title={title}>
  <MoveNotice />
  {Astro.url.searchParams.get('boxSaved') === '1' && (
    <p
      role="status"
      class="mb-4 rounded-lg bg-emerald-950 p-3 text-emerald-200"
    >
      Box details saved.
    </p>
  )}
  <Breadcrumbs items={[{ href: '/boxes', label: 'Boxes' }, { label: title }]} />
  <PageHeader title={title} eyebrow={`${box.type} box · #${box.id}`}>
    <div slot="actions" class="flex gap-2">
      <a
        href={`/boxes/${id}/edit`}
        class="rounded-lg border border-zinc-800 px-3 py-2 text-sm text-zinc-300"
      >
        Edit box
      </a>
      {navigation.previousId && (
        <a
          href={boxUrl(navigation.previousId)}
          aria-label={`Previous box, ${navigation.previousId}`}
          class="rounded-lg border border-zinc-800 px-3 py-2 text-sm text-zinc-300 hover:bg-zinc-900"
        >
          ← {navigation.previousId}
        </a>
      )}
      {navigation.nextId && (
        <a
          href={boxUrl(navigation.nextId)}
          aria-label={`Next box, ${navigation.nextId}`}
          class="rounded-lg border border-zinc-800 px-3 py-2 text-sm text-zinc-300 hover:bg-zinc-900"
        >
          {navigation.nextId} →
        </a>
      )}
    </div>
  </PageHeader>
  {selectedSeries && (
    <p class="mb-5 text-sm text-zinc-400">
      Showing {selectedSeries.name} in this box.{' '}
      <a href={`/boxes/${id}`} class="ml-2 underline">
        Show all comics in this box
      </a>
    </p>
  )}

  <section class="mb-8 grid gap-3 sm:grid-cols-3">
    <StatCard label="Value" value={formatMoney(value)} />
    <StatCard label="Physical copies" value={String(quantity)} />
    <StatCard label="Purchase groups" value={String(holdings.length)} />
  </section>

  {holdings.length ? (
    <BoxHoldings boxes={boxes} holdings={holdings} />
  ) : (
    <EmptyState
      title="No matching comics in this box"
      description="Show all comics or try another box."
    />
  )}
</AppLayout>
