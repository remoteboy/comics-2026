---
import AppLayout from '@/components/AppLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { listBoxes } from '@/features/boxes/repository';
import { formatMoney } from '@/lib/format';

const boxes = await listBoxes();
---

<AppLayout title="Boxes">
  <PageHeader title="Boxes" description="Physical storage locations from the legacy collection." />

  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
    {boxes.map((box) => (
      <a href={`/boxes/${box.id}`} class="rounded-xl border border-zinc-800 bg-zinc-900/50 p-5 hover:bg-zinc-900">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-xl font-bold text-white">Box {box.id}</p>
            <p class="mt-1 text-xs font-medium tracking-wide text-zinc-500 uppercase">{box.type}</p>
          </div>
          <p class="text-sm font-semibold text-zinc-200">{formatMoney(box.valueCents)}</p>
        </div>
        <div class="mt-5 flex gap-4 text-sm text-zinc-400">
          <span>{box.copyCount} copies</span>
          <span>{box.holdingCount} holdings</span>
        </div>
      </a>
    ))}
  </div>
</AppLayout>
